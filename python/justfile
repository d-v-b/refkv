# The refkv Python distribution (pyproject.toml): the package src/refkv with its bindings to the
# Rust core (the crate ../rust/refkv-python, the module refkv._core). From the root:
# `just python::test` and so on. The build recipes write git's version into the bindings'
# Cargo.toml and Cargo.lock for the build, and restore both afterwards (tools/version.py run;
# RELEASING.md).

set shell := ["bash", "-euo", "pipefail", "-c"]

out := source_directory() / "dist"

[private]
default:
    @just --list

# Run the package's tests in the repository's environment (uv sync builds refkv into it first)
test *args:
    cd .. && uv sync -q --locked && uv run pytest -q python/tests {{args}}

# Build the bindings crate alone with cargo (no tests of its own: this checks it compiles and links)
cargo-test:
    cargo test --release --manifest-path ../rust/refkv-python/Cargo.toml

# Print the version git describes (tools/version.py), as semver and as PEP 440
version:
    @python3 tools/version.py show
    @python3 tools/version.py pep440

# Write the version git describes into the bindings' Cargo.toml and Cargo.lock (CI's release
# builds, whose checkout is thrown away; locally, `build` and `sdist` do it for the build
# alone)
version-write:
    python3 tools/version.py write

# Build a release wheel into dist/ (abi3, for this platform)
build *args:
    python3 tools/version.py run -- uvx maturin build --release --out {{quote(out)}} {{args}}

# Build the sdist into dist/ (it holds the bindings and the core, and builds on its own)
sdist:
    python3 tools/version.py run -- uvx maturin sdist --out {{quote(out)}}

# Check an install of refkv without the test environment: pass the Python of an environment
# where only `pip install python/` (or `pip install 'python/[zarr]'`, with mode=zarr) was run
# (default: a fresh one of each, in a temporary directory). A plain recipe, not a shebang one,
# so it runs under Windows' Git Bash too, where a venv's Python is Scripts/python.exe
check python="" mode="":
    if [ -n {{quote(python)}} ]; then \
        {{quote(python)}} tests/check_base_install.py {{mode}}; \
    else \
        for mode in base zarr; do \
            venv="$(mktemp -d)/$mode"; \
            uv venv -q "$venv"; \
            if [ "$mode" = base ]; then spec=.; else spec=".[zarr]"; fi; \
            uv pip install -q --python "$venv" "$spec"; \
            py="$venv/bin/python"; [ -x "$py" ] || py="$venv/Scripts/python.exe"; \
            "$py" tests/check_base_install.py "$mode"; \
        done; \
    fi
