{
  "source_model": "zarr2",
  "version": 1,
  "about": "The source model of a Zarr v2 store (spec/virtualize/zarr2.md, spec/virtualize.md §10 <https://github.com/d-v-b/refkv/blob/main/spec/virtualize/zarr2.md#10-zarr-v2-profile>): the data types and compressors the Zarr v2 convention reads, and the roles a node's .zarray, its compressor and fill value, a .zgroup and a .zattrs play, each with the constraints a store must meet to have the convention's layout. The parser reads the listing and the documents (JSON by spec/virtualize.md §1.6 <https://github.com/d-v-b/refkv/blob/main/spec/virtualize.md#16-json-documents>) and checks this schema for each node, in path order; the projection reads a valid IR and checks nothing.",
  "limits": {
    "max_safe": 9007199254740991,
    "max_dims": 32,
    "max_block": 2147483647
  },
  "tables": {
    "about": {
      "dtypes": "The dtypes of spec/virtualize/zarr2.md §3 <https://github.com/d-v-b/refkv/blob/main/spec/virtualize/zarr2.md#3-arrays>: the Zarr v3 data type, its size b, and the byte order character",
      "int_ranges": "the values of each integer data type, for its fill value",
      "float_max": "the largest finite value of each float data type but float64, by size b, compared as binary64",
      "compressors": "spec/virtualize/zarr2.md §3.1 <https://github.com/d-v-b/refkv/blob/main/spec/virtualize/zarr2.md#31-compressors>: each id's levels (lo, hi) and the level numcodecs uses when the member is absent, and the members its codec carries",
      "zarray_read": "the members of .zarray that §3 <https://github.com/d-v-b/refkv/blob/main/spec/virtualize/zarr2.md#3-arrays> reads; the others are kept in the source metadata M (§4 <https://github.com/d-v-b/refkv/blob/main/spec/virtualize/zarr2.md#4-source-metadata>)"
    },
    "dtypes": {
      "|b1": {
        "data_type": "bool",
        "b": 1,
        "order": "|"
      },
      "<b1": {
        "data_type": "bool",
        "b": 1,
        "order": "<"
      },
      ">b1": {
        "data_type": "bool",
        "b": 1,
        "order": ">"
      },
      "|i1": {
        "data_type": "int8",
        "b": 1,
        "order": "|"
      },
      "<i1": {
        "data_type": "int8",
        "b": 1,
        "order": "<"
      },
      ">i1": {
        "data_type": "int8",
        "b": 1,
        "order": ">"
      },
      "|u1": {
        "data_type": "uint8",
        "b": 1,
        "order": "|"
      },
      "<u1": {
        "data_type": "uint8",
        "b": 1,
        "order": "<"
      },
      ">u1": {
        "data_type": "uint8",
        "b": 1,
        "order": ">"
      },
      "<i2": {
        "data_type": "int16",
        "b": 2,
        "order": "<"
      },
      ">i2": {
        "data_type": "int16",
        "b": 2,
        "order": ">"
      },
      "<u2": {
        "data_type": "uint16",
        "b": 2,
        "order": "<"
      },
      ">u2": {
        "data_type": "uint16",
        "b": 2,
        "order": ">"
      },
      "<f2": {
        "data_type": "float16",
        "b": 2,
        "order": "<"
      },
      ">f2": {
        "data_type": "float16",
        "b": 2,
        "order": ">"
      },
      "<i4": {
        "data_type": "int32",
        "b": 4,
        "order": "<"
      },
      ">i4": {
        "data_type": "int32",
        "b": 4,
        "order": ">"
      },
      "<u4": {
        "data_type": "uint32",
        "b": 4,
        "order": "<"
      },
      ">u4": {
        "data_type": "uint32",
        "b": 4,
        "order": ">"
      },
      "<f4": {
        "data_type": "float32",
        "b": 4,
        "order": "<"
      },
      ">f4": {
        "data_type": "float32",
        "b": 4,
        "order": ">"
      },
      "<i8": {
        "data_type": "int64",
        "b": 8,
        "order": "<"
      },
      ">i8": {
        "data_type": "int64",
        "b": 8,
        "order": ">"
      },
      "<u8": {
        "data_type": "uint64",
        "b": 8,
        "order": "<"
      },
      ">u8": {
        "data_type": "uint64",
        "b": 8,
        "order": ">"
      },
      "<f8": {
        "data_type": "float64",
        "b": 8,
        "order": "<"
      },
      ">f8": {
        "data_type": "float64",
        "b": 8,
        "order": ">"
      }
    },
    "int_ranges": {
      "int8": [
        -128,
        127
      ],
      "uint8": [
        0,
        255
      ],
      "int16": [
        -32768,
        32767
      ],
      "uint16": [
        0,
        65535
      ],
      "int32": [
        -2147483648,
        2147483647
      ],
      "uint32": [
        0,
        4294967295
      ],
      "int64": [
        -9223372036854775808,
        9223372036854775807
      ],
      "uint64": [
        0,
        18446744073709551615
      ]
    },
    "float_max": {
      "2": 65504,
      "4": 3.4028234663852886e+38
    },
    "float_words": [
      "NaN",
      "Infinity",
      "-Infinity"
    ],
    "compressors": {
      "zlib": {
        "lo": -1,
        "hi": 9,
        "default": 1,
        "carried": [
          "id",
          "level"
        ]
      },
      "gzip": {
        "lo": -1,
        "hi": 9,
        "default": 1,
        "carried": [
          "id",
          "level"
        ]
      },
      "zstd": {
        "lo": -131072,
        "hi": 22,
        "default": 0,
        "carried": [
          "id",
          "level",
          "checksum"
        ]
      },
      "blosc": {
        "carried": [
          "id",
          "cname",
          "clevel",
          "shuffle",
          "blocksize"
        ]
      }
    },
    "blosc_names": [
      "blosclz",
      "lz4",
      "lz4hc",
      "snappy",
      "zlib",
      "zstd"
    ],
    "blosc_shuffles": [
      0,
      1,
      2,
      -1
    ],
    "zarray_read": [
      "zarr_format",
      "shape",
      "chunks",
      "dtype",
      "order",
      "compressor",
      "filters",
      "fill_value",
      "dimension_separator"
    ]
  },
  "elements": {
    "about": "spec/virtualize/zarr2.md §4.1 <https://github.com/d-v-b/refkv/blob/main/spec/virtualize/zarr2.md#41-elements>: the store's directories and objects (conventions §8.9 <https://github.com/d-v-b/refkv/blob/main/spec/conventions.md#89-stores>), and in each node document read, a value per top-level member"
  },
  "roles": {
    "zarray": {
      "about": "an array's .zarray (spec/virtualize/zarr2.md §3 <https://github.com/d-v-b/refkv/blob/main/spec/virtualize/zarr2.md#3-arrays>)",
      "given": {
        "path": "the array's path (/ for the root)",
        "object": "the document is a JSON object",
        "zarr_format": "",
        "shape": "",
        "chunks": "",
        "dtype": "",
        "order": "",
        "filters": "",
        "dimension_separator": ""
      },
      "derive": {
        "n": "len(shape)"
      },
      "constraints": [
        {
          "require": "object",
          "message": "{path}/.zarray is not a JSON object"
        },
        {
          "require": "int(zarr_format) && zarr_format == 2",
          "message": "{path}/.zarray: zarr_format is not 2"
        },
        {
          "require": "kind(shape) == 'list' && len(shape) <= max_dims && int(shape, 0, max_safe)",
          "message": "{path}: shape {shape} is not up to 32 sizes"
        },
        {
          "require": "kind(chunks) == 'list' && len(chunks) == len(shape) && int(chunks, 1, max_safe)",
          "message": "{path}: chunks {chunks} is not {n} chunk sizes"
        },
        {
          "require": "kind(dtype) == 'string' && present(at(dtypes, dtype))",
          "message": "dtype {dtype} is not supported"
        },
        {
          "require": "in(order, ['C', 'F'])",
          "message": "{path}: order {order} is not C or F"
        },
        {
          "require": "!present(filters) || (kind(filters) == 'list' && len(filters) == 0)",
          "message": "{path}: filters are not supported"
        },
        {
          "require": "!present(dimension_separator) || in(dimension_separator, ['.', '/'])",
          "message": "{path}: dimension_separator {dimension_separator} is not . or /"
        }
      ]
    },
    "fill": {
      "about": "an array's fill_value (spec/virtualize/zarr2.md §3 <https://github.com/d-v-b/refkv/blob/main/spec/virtualize/zarr2.md#3-arrays>), given its data type",
      "given": {
        "path": "",
        "fill": "the member (absent when null)",
        "data_type": "",
        "b": "",
        "family": "bool, int or float"
      },
      "constraints": [
        {
          "require": "!present(fill) || (family == 'bool' && kind(fill) == 'bool') || (family == 'int' && int(fill, first(at(int_ranges, data_type)), at(at(int_ranges, data_type), 1))) || (family == 'float' && (in(fill, float_words) || (kind(fill) == 'number' && (b == 8 || abs(fill) <= at(float_max, b)))))",
          "message": "fill_value {fill} is not a {data_type}"
        }
      ]
    },
    "compressor": {
      "about": "an array's compressor (spec/virtualize/zarr2.md §3.1 <https://github.com/d-v-b/refkv/blob/main/spec/virtualize/zarr2.md#31-compressors>); has_<member>: the member is written, null included",
      "given": {
        "path": "",
        "compressor": "the member (absent when null)",
        "has_level": "",
        "has_checksum": "",
        "has_blocksize": ""
      },
      "derive": {
        "lo": "at(at(compressors, compressor.id), 'lo')",
        "hi": "at(at(compressors, compressor.id), 'hi')"
      },
      "constraints": [
        {
          "require": "!present(compressor) || (kind(compressor) == 'object' && kind(compressor.id) == 'string')",
          "message": "compressor is not null or an object with a string id"
        },
        {
          "require": "!present(compressor) || present(at(compressors, compressor.id))",
          "message": "compressor {compressor.id} is not supported"
        },
        {
          "require": "!in(compressor.id, ['zlib', 'gzip', 'zstd']) || !has_level || int(compressor.level, lo, hi)",
          "message": "{compressor.id} level {compressor.level} is not an integer from {lo} to {hi}"
        },
        {
          "require": "!in(compressor.id, ['zstd']) || !has_checksum || kind(compressor.checksum) == 'bool'",
          "message": "zstd checksum {compressor.checksum} is not a boolean"
        },
        {
          "require": "!in(compressor.id, ['blosc']) || in(compressor.cname, blosc_names)",
          "message": "blosc cname {compressor.cname} is not supported"
        },
        {
          "require": "!in(compressor.id, ['blosc']) || int(compressor.clevel, 0, 9)",
          "message": "blosc clevel {compressor.clevel} is not an integer from 0 to 9"
        },
        {
          "require": "!in(compressor.id, ['blosc']) || (int(compressor.shuffle) && in(compressor.shuffle, blosc_shuffles))",
          "message": "blosc shuffle {compressor.shuffle} is not supported"
        },
        {
          "require": "!in(compressor.id, ['blosc']) || !has_blocksize || int(compressor.blocksize, 0, max_block)",
          "message": "blosc blocksize {compressor.blocksize} is not supported"
        }
      ]
    },
    "zgroup": {
      "about": "an explicit group's .zgroup (spec/virtualize/zarr2.md §2 <https://github.com/d-v-b/refkv/blob/main/spec/virtualize/zarr2.md#2-nodes>)",
      "given": {
        "key": "",
        "object": "",
        "zarr_format": ""
      },
      "constraints": [
        {
          "require": "object && int(zarr_format) && zarr_format == 2",
          "message": "{key}: zarr_format is not 2"
        }
      ]
    },
    "zattrs": {
      "about": "a node's .zattrs (spec/virtualize/zarr2.md §2 <https://github.com/d-v-b/refkv/blob/main/spec/virtualize/zarr2.md#2-nodes>)",
      "given": {
        "key": "",
        "object": ""
      },
      "constraints": [
        {
          "require": "object",
          "message": "{key} is not a JSON object"
        }
      ]
    }
  }
}
