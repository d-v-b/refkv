# The Rust implementation of the conformance harness (HARNESS.md): a reader of revision 11, and the
# archive writer of rust/refkv-vzip (./vzip runs the release build).

set shell := ["bash", "-euo", "pipefail", "-c"]

[private]
default:
    @just --list

# Build the release binary that ./vzip runs
build:
    cargo build --release

# Run the unit tests and the CLI tests
test: build
    cargo test --release --quiet
    python3 tests/cli_tests.py
