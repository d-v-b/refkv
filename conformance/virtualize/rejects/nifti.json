    {
      "test": "nifti_reject_vox_offset_in_extender",
      "input": "nifti_reject_vox_offset_in_extender.nii",
      "message": "vox_offset 348 is not from 352 to 2^53 - 1"
    },
    {
      "test": "nifti_reject_vox_offset_nan",
      "input": "nifti_reject_vox_offset_nan.nii",
