{
  "about": "The inputs the nifti profile rejects, each with the start of its message (the Rust tests' prefix, or what each store test's message contains), and, where the Python host rejects it earlier, the host's message. rust/refkv-ir/build.rs writes a Rust test per case into tests/nifti.rs; python/tests/ir/test_rejects.py checks each through the host and that every rejected fixture is listed here.",
  "cases": [
    {
      "test": "nifti_reject_binary",
      "input": "nifti_reject_binary.nii",
      "message": "unsupported NIfTI datatype 1 (BINARY)"
    },
    {
      "test": "nifti_reject_bitpix",
      "input": "nifti_reject_bitpix.nii",
      "message": "bitpix 8 does not match datatype 4"
    },
    {
      "test": "nifti_reject_complex64",
      "input": "nifti_reject_complex64.nii",
      "message": "unsupported NIfTI datatype 32 (COMPLEX64)"
    },
    {
      "test": "nifti_reject_datatype_unknown",
      "input": "nifti_reject_datatype_unknown.nii",
      "message": "unknown NIfTI datatype 3"
    },
    {
      "test": "nifti_reject_dim0",
      "input": "nifti_reject_dim0.nii",
      "message": "dim[0] = 0 is not from 1 to 7"
    },
    {
      "test": "nifti_reject_dim0_8",
      "input": "nifti_reject_dim0_8.nii",
      "message": "dim[0] = 8 is not from 1 to 7"
    },
    {
      "test": "nifti_reject_dim6",
      "input": "nifti_reject_dim6.nii",
      "message": "dimensions 6 and 7 must have size 1"
    },
    {
      "test": "nifti_reject_dim7",
      "input": "nifti_reject_dim7.nii",
      "message": "dimensions 6 and 7 must have size 1"
    },
    {
      "test": "nifti_reject_dim_negative",
      "input": "nifti_reject_dim_negative.nii",
      "message": "dim[2] = -2 is not from 1 to 2^53 - 1"
    },
    {
      "test": "nifti_reject_dim_zero",
      "input": "nifti_reject_dim_zero.nii",
      "message": "dim[2] = 0 is not from 1 to 2^53 - 1"
    },
    {
      "test": "nifti_reject_float128",
      "input": "nifti_reject_float128.nii",
      "message": "unsupported NIfTI datatype 1536 (FLOAT128)"
    },
    {
      "test": "nifti_reject_n2_dim_huge",
      "input": "nifti_reject_n2_dim_huge.nii",
      "message": "dim[1] = 9007199254740992 is not from 1 to 2^53 - 1"
