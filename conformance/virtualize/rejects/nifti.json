    {
      "test": "nifti_reject_n2_short_header",
      "input": "nifti_reject_n2_short_header.nii",
      "message": "file too short for a 540-byte NIfTI-2 header"
    },
    {
      "test": "nifti_reject_n2_size_overflow",
      "input": "nifti_reject_n2_size_overflow.nii",
      "message": "the 1237940039285380274899124224-byte voxel data at 544 is outside the 556-byte file"
    },
    {
      "test": "nifti_reject_n2_vox_offset_low",
      "input": "nifti_reject_n2_vox_offset_low.nii",
      "message": "vox_offset 540 is not from 544 to 2^53 - 1"
    },
    {
      "test": "nifti_reject_pair_magic",
      "input": "nifti_reject_pair_magic.nii",
      "message": "not a NIfTI-1 or NIfTI-2 single file",
