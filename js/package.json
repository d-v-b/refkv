{
  "name": "refkv",
  "private": true,
  "type": "module",
  "description": "refkv in the browser: a service worker that serves vzip archives, and the image files and stores it zarrifies, as plain HTTP Zarr",
  "imports": {
    "#net": {
      "node": "./src/net_node.ts",
      "default": "./src/net_browser.ts"
    },
    "#irwasm": {
      "node": "./src/zarrify/ir/wasm_node.ts",
      "default": "./src/zarrify/ir/wasm_browser.ts"
    },
    "#profiles": {
      "node": "./src/zarrify/profiles_node.ts",
      "default": "./src/zarrify/profiles_bundled.ts"
    }
  },
  "license": "MIT OR Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "esbuild": "0.25.12",
    "highlight.js": "11.12.0",
    "ol": "10.11.0",
    "playwright": "1.60.0",
    "proj4": "2.22.0",
    "typescript": "5.9.3",
    "zarrita": "0.7.5"
  }
}
