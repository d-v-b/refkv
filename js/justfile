# The browser implementation: a service worker serving vzip archives, and zarrified files and
# stores of every format of the registry (spec/zarrify/profiles/), as plain HTTP Zarr. Every
# format is zarrified by the Rust core (rust/refkv-ir) built for wasm32, which `wasm` builds
# (not committed).

set shell := ["bash", "-euo", "pipefail", "-c"]

[private]
default:
    @just --list

# Install the pinned development dependencies
install:
    npm ci

# Build the Rust core for wasm32 (rust/refkv-ir/target/web/refkv_ir.wasm; optimized by wasm-opt when installed)
wasm:
    ../rust/refkv-ir/wasm/build.sh

# Build the phkv reader for wasm32 (rust/refkv-phkv/target/web/refkv_phkv.wasm; optimized by wasm-opt when installed)
phkv-wasm:
    ../rust/refkv-phkv/wasm/build.sh

# Write the standalone phkv store that the phkv tests read (rust/refkv-phkv/target/web/fixture.phkv)
phkv-fixture:
    cargo run --quiet --example wasm_fixture --manifest-path ../rust/refkv-phkv/Cargo.toml -- ../rust/refkv-phkv/target/web/fixture.phkv

# Bundle the service worker and demo, with the Rust core's and the phkv reader's modules beside them (build.mjs)
build: wasm phkv-wasm
    node build.mjs

# Type-check the sources
typecheck:
    npx tsc -p .

# Build the Rust core's test module: the same with test-only hooks (rust/refkv-ir/target/web-test)
wasm-test:
    ../rust/refkv-ir/wasm/build.sh test

# Type-check, then run the Node tests
test: wasm wasm-test phkv-wasm phkv-fixture typecheck
    node --test "test/**/*.test.ts"

# Serve the demo locally (default port 8000)
serve port="8000":
    node ../demo/serve.mjs {{port}}

# Zarrify an image file or store URL with the browser code into a .vzip archive
zarrify url out:
    node conformance/zarrify.ts {{quote(url)}} {{quote(out)}}
