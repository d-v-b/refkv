# The browser implementation: a service worker serving vzip archives, and virtualized files and
# stores of every format of the registry (spec/virtualize/profiles/), as plain HTTP Zarr. Every
# format is virtualized by the Rust core (rust/refkv-ir) built for wasm32, which `wasm` builds
# (not committed).

set shell := ["bash", "-euo", "pipefail", "-c"]

[private]
default:
    @just --list

# Install the pinned development dependencies
install:
    npm ci

# Build the Rust core for wasm32 (rust/refkv-ir/target/web/refkv_ir.wasm; optimized by wasm-opt when installed)
wasm:
    ../rust/refkv-ir/wasm/build.sh

# Bundle the service worker and demo, with the Rust core's module beside them (build.mjs)
build: wasm
    node build.mjs

# Type-check the sources
typecheck:
    npx tsc -p .

# Build the Rust core's test module: the same with test-only hooks (rust/refkv-ir/target/web-test)
wasm-test:
    ../rust/refkv-ir/wasm/build.sh test

# Type-check, then run the Node tests
test: wasm wasm-test typecheck
    node --test "test/**/*.test.ts"

# Serve the demo locally (default port 8000)
serve port="8000":
    node ../demo/serve.mjs {{port}}

# Virtualize an image file or store URL with the browser code into a .vzip archive
virtualize url out:
    node conformance/virtualize.ts {{quote(url)}} {{quote(out)}}
