# Python-generated files
__pycache__/
*.py[oc]
build/
!python/src/refkv/build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
design/experiments/_bench/
__pycache__/

# vzip archives are generated (see `just archives`); regenerate them instead of
# committing them. Hand-made test vectors can still be added with `git add -f`.
*.vzip
design/experiments/out/ng_demo/expected.npy

# Conformance and comparison outputs
conformance/results/

# Test scratch output
conformance/impls/typescript/test/.tmp/

# The Rust workspace's build output (rust/Cargo.toml), the wasm32 modules (rust/target/web,
# rust/target/web-test) included
rust/target/
# and each crate's own, which builds before the workspace left: delete them (`rm -rf rust/*/target`)
rust/*/target/

# the Python bindings to the Rust core, compiled into the package by `uv sync` (python/pyproject.toml)
python/src/refkv/_core*.so
python/src/refkv/_core*.pyd
examples-out/

# measure.py's cache of remote files (design/experiments/third_party)
design/experiments/third_party/.cache/

# the documentation site (`just docs`)
docs-site/_build/
