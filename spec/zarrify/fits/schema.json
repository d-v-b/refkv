{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/d-v-b/refkv/refs/heads/main/spec/zarrify/fits/schema.json",
  "title": "refkv FITS convention, version 0",
  "description": "The zarr.json of a node that declares the refkv FITS convention (https://github.com/d-v-b/refkv/blob/main/spec/zarrify/fits.md)",
  "type": "object",
  "properties": {
    "zarr_format": {
      "type": "integer",
      "const": 3
    },
    "node_type": {
      "type": "string",
      "enum": [
        "group",
        "array"
      ]
    },
    "attributes": {
      "type": "object",
      "properties": {
        "ome": {
          "type": "object",
          "description": "OME-NGFF 0.5 metadata"
        },
        "zarr_conventions": {
          "type": "array",
          "contains": {
            "$ref": "#/$defs/conventionMetadata"
          },
          "minContains": 1,
          "maxContains": 1
        },
        "refkv_zarrified": {
          "oneOf": [
            {
              "$ref": "#/$defs/rootProperty"
            },
            {
              "$ref": "#/$defs/nodeProperty"
            }
          ]
        }
      },
      "required": [
        "zarr_conventions",
        "refkv_zarrified"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "zarr_format",
    "node_type",
    "attributes"
  ],
  "$defs": {
    "conventionMetadata": {
      "type": "object",
      "description": "The FITS convention's metadata object in zarr_conventions",
      "properties": {
        "uuid": {
          "type": "string",
          "const": "4b0d3a7e-1c52-4f6a-9b8e-2d7f0c6a1e93"
        },
        "schema_url": {
          "type": "string",
          "const": "https://raw.githubusercontent.com/d-v-b/refkv/refs/heads/main/spec/zarrify/fits/schema.json"
        },
        "spec_url": {
          "type": "string",
          "const": "https://github.com/d-v-b/refkv/blob/main/spec/zarrify/fits.md"
        },
        "name": {
          "type": "string",
          "const": "refkv_zarrified"
        },
        "description": {
          "type": "string",
          "const": "The Zarr layout of a FITS source zarrified by refkv, and the source's metadata"
        }
      },
      "required": [
        "uuid",
        "schema_url",
        "spec_url",
        "name",
        "description"
      ],
      "additionalProperties": false
    },
    "rootProperty": {
      "type": "object",
      "description": "The root's property: the profile and version that produced the hierarchy, its source, and the root's source metadata",
      "properties": {
        "profile": {
          "type": "string",
          "const": "fits"
        },
        "version": {
          "type": "integer",
          "const": 0
        },
        "source": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "description": "The URL of the source file"
            }
          },
          "required": [
            "url"
          ],
          "additionalProperties": false
        },
        "layouts": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[^/]+(/[^/]+)*$"
          },
          "description": "The other layouts of the source in this hierarchy, by name, each the path of its node below the root (spec/conventions.md §9 <https://github.com/d-v-b/refkv/blob/main/spec/conventions.md#9-dataset-layouts>)"
        },
        "fits": {
          "$ref": "#/$defs/sourceMetadata"
        }
      },
      "required": [
        "profile",
        "version",
        "source"
      ],
      "additionalProperties": false
    },
    "sourceMetadata": {
      "anyOf": [
        {
          "type": "object",
          "description": "The root's: the table of HDUs and the primary header's cards (spec/zarrify/fits.md §5.1 <https://github.com/d-v-b/refkv/blob/main/spec/zarrify/fits.md#51-the-root>)",
          "properties": {
            "hdus": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "index": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "type": {
                    "enum": [
                      "primary",
                      "image",
                      "table",
                      "bintable"
                    ]
                  },
                  "kind": {
                    "enum": [
                      "empty",
                      "image",
                      "table"
                    ]
                  },
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "version": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "bitpix": {
                    "enum": [
                      8,
                      16,
                      32,
                      64,
                      -32,
                      -64
                    ]
                  },
                  "naxis": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "pcount": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "gcount": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "offset": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "header_bytes": {
                    "type": "integer",
                    "minimum": 2880
                  },
                  "data_offset": {
                    "type": "integer",
                    "minimum": 2880
                  },
                  "data_bytes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "compression": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "object",
                        "description": "A tile-compressed image's compression (spec/zarrify/fits.md §3.3 <https://github.com/d-v-b/refkv/blob/main/spec/zarrify/fits.md#33-tile-compressed-images>)",
                        "properties": {
                          "type": {
                            "enum": [
                              "RICE_1",
                              "GZIP_1",
                              "GZIP_2",
                              "NOCOMPRESS"
                            ]
                          },
                          "parameters": {
                            "type": "object",
                            "properties": {
                              "BLOCKSIZE": {
                                "enum": [
                                  16,
                                  32
                                ]
                              },
                              "BYTEPIX": {
                                "enum": [
                                  1,
                                  2,
                                  4
                                ]
                              }
                            },
                            "required": [
                              "BLOCKSIZE",
                              "BYTEPIX"
                            ],
                            "additionalProperties": false
                          },
                          "zbitpix": {
                            "enum": [
                              8,
                              16,
                              32,
                              64,
                              -32,
                              -64
                            ]
                          },
                          "tile": {
                            "type": "array",
                            "items": {
                              "type": "integer",
                              "minimum": 1
                            },
                            "description": "The tile shape, in the array's order"
                          },
                          "quantize": {
                            "enum": [
                              "NO_DITHER",
                              "SUBTRACTIVE_DITHER_1",
                              "SUBTRACTIVE_DITHER_2"
                            ]
                          },
                          "dither_seed": {
                            "type": [
                              "integer",
                              "null"
                            ],
                            "minimum": 1,
                            "maximum": 10000
                          },
                          "zblank": {
                            "type": [
                              "integer",
                              "null"
                            ]
                          },
                          "tiles": {
                            "type": "integer",
                            "minimum": 0
                          }
                        },
                        "required": [
                          "type",
                          "parameters",
                          "zbitpix",
                          "tile",
                          "quantize",
                          "dither_seed",
                          "zblank",
                          "tiles"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "required": [
                  "index",
                  "type",
                  "kind",
                  "name",
                  "version",
                  "bitpix",
                  "naxis",
                  "pcount",
                  "gcount",
                  "offset",
                  "header_bytes",
                  "data_offset",
                  "data_bytes",
                  "compression"
                ],
                "additionalProperties": false
              }
            },
            "cards": {
              "description": "The header's cards, [keyword, value, comment] each, in order: a string, a logical, an integer (exact; as a string of digits past 2^53 - 1), a real (its binary64 value), a complex as [re, im], null for no value, or {\"text\": t} for a value the standard does not define; a commentary card's text is its comment. Null when the cards would take more than 65536 bytes of JSON",
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "prefixItems": [
                      {
                        "type": "string"
                      },
                      {
                        "anyOf": [
                          {
                            "type": "null"
                          },
                          {
                            "type": "boolean"
                          },
                          {
                            "type": "number"
                          },
                          {
                            "type": "string"
                          },
                          {
                            "type": "array",
                            "items": {
                              "type": "number"
                            },
                            "minItems": 2,
                            "maxItems": 2
                          },
                          {
                            "type": "object",
                            "properties": {
                              "text": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "text"
                            ],
                            "additionalProperties": false
                          }
                        ]
                      },
                      {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    ]
                  }
                }
              ]
            }
          },
          "required": [
            "hdus",
            "cards"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "An HDU node's: its index and cards, an image's scaling cards, a table's columns",
          "properties": {
            "index": {
              "type": "integer",
              "minimum": 0
            },
            "cards": {
              "description": "The header's cards, [keyword, value, comment] each, in order: a string, a logical, an integer (exact; as a string of digits past 2^53 - 1), a real (its binary64 value), a complex as [re, im], null for no value, or {\"text\": t} for a value the standard does not define; a commentary card's text is its comment. Null when the cards would take more than 65536 bytes of JSON",
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "prefixItems": [
                      {
                        "type": "string"
                      },
                      {
                        "anyOf": [
                          {
                            "type": "null"
                          },
                          {
                            "type": "boolean"
                          },
                          {
                            "type": "number"
                          },
                          {
                            "type": "string"
                          },
                          {
                            "type": "array",
                            "items": {
                              "type": "number"
                            },
                            "minItems": 2,
                            "maxItems": 2
                          },
                          {
                            "type": "object",
                            "properties": {
                              "text": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "text"
                            ],
                            "additionalProperties": false
                          }
                        ]
                      },
                      {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    ]
                  }
                }
              ]
            },
            "bscale": {
              "type": [
                "number",
                "null"
              ]
            },
            "bzero": {
              "type": [
                "number",
                "null"
              ]
            },
            "blank": {
              "type": [
                "number",
                "null"
              ]
            },
            "bunit": {
              "type": [
                "string",
                "null"
              ]
            },
            "columns": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "form": {
                    "type": "string"
                  },
                  "unit": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "dim": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "scale": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "zero": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "null": {
                    "type": [
                      "string",
                      "number",
                      "null"
                    ]
                  },
                  "disp": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "bcol": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                },
                "required": [
                  "name",
                  "form",
                  "unit",
                  "dim",
                  "scale",
                  "zero",
                  "null",
                  "disp",
                  "bcol"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "index",
            "cards"
          ],
          "additionalProperties": false
        },
        {
          "$ref": "#/$defs/mirror"
        },
        {
          "$ref": "#/$defs/mirrorView"
        }
      ]
    },
    "headerValue": {
      "description": "A translated header value (spec/conventions.md §6 <https://github.com/d-v-b/refkv/blob/main/spec/conventions.md#6-source-metadata-as-json>)",
      "anyOf": [
        {
          "type": "number"
        },
        {
          "$ref": "#/$defs/text"
        },
        {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ]
          }
        }
      ]
    },
    "text": {
      "description": "A text value: a string (UTF-8), or its ISO 8859-1 reading when it is not UTF-8",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "latin1": {
              "type": "string"
            }
          },
          "required": [
            "latin1"
          ],
          "additionalProperties": false
        }
      ]
    },
    "mirror": {
      "type": "object",
      "description": "refkv_source's: the IR mirror's description (spec/conventions.md §8.2 <https://github.com/d-v-b/refkv/blob/main/spec/conventions.md#82-the-table>)",
      "properties": {
        "ir": {
          "type": "object",
          "properties": {
            "version": {
              "const": 2
            },
            "size": {
              "type": "integer",
              "minimum": 0,
              "description": "The source's size in bytes (a store IR's: its objects' sizes, summed)"
            },
            "objects": {
              "type": "integer",
              "minimum": 0,
              "description": "A store IR's objects (spec/conventions.md §8.9 <https://github.com/d-v-b/refkv/blob/main/spec/conventions.md#89-stores>); a file IR has none"
            },
            "elements": {
              "type": "integer",
              "minimum": 1,
              "description": "The elements, column runs expanded"
            },
            "rows": {
              "type": "integer",
              "minimum": 1,
              "description": "The rows the table stores"
            },
            "names": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "prefixItems": [
                {
                  "const": ""
                }
              ],
              "description": "The interned names, sorted; the first, \"\", is the root's (conventions §8.1 <https://github.com/d-v-b/refkv/blob/main/spec/conventions.md#81-elements>)"
            },
            "types": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "prefixItems": [
                {
                  "const": ""
                }
              ],
              "description": "The interned types (§8.6 <https://github.com/d-v-b/refkv/blob/main/spec/conventions.md#86-types>)"
            },
            "forms": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "The interned forms, each a JSON text (§8.5 <https://github.com/d-v-b/refkv/blob/main/spec/conventions.md#85-forms-and-recipes>)"
            }
          },
          "required": [
            "version",
            "size",
            "elements",
            "rows",
            "names",
            "types",
            "forms"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "ir"
      ],
      "additionalProperties": false
    },
    "mirrorView": {
      "type": "object",
      "description": "A view group's (refkv_source/tree/...): a struct's view document (spec/conventions.md §8.7 <https://github.com/d-v-b/refkv/blob/main/spec/conventions.md#87-the-view>)",
      "properties": {
        "$vz": {
          "const": "derived",
          "description": "A derived element's document"
        },
        "$form": {
          "type": [
            "string",
            "null"
          ],
          "description": "A derived element's form (§8.5 <https://github.com/d-v-b/refkv/blob/main/spec/conventions.md#85-forms-and-recipes>)"
        },
        "$partial": {
          "const": true,
          "description": "The document stops short of the struct's children"
        }
      },
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/viewValue"
      }
    },
    "viewValue": {
      "description": "A child's view: a JSON value, a nested document, or a $vz form",
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null",
            "array"
          ]
        },
        {
          "type": "object",
          "properties": {
            "$vz": {
              "enum": [
                "alias",
                "group",
                "element",
                "derived",
                "int",
                "float",
                "bytes",
                "utf16"
              ]
            }
          },
          "required": [
            "$vz"
          ]
        },
        {
          "type": "object"
        }
      ]
    },
    "nodeProperty": {
      "type": "object",
      "description": "Any other node's property: its source metadata only",
      "properties": {
        "fits": {
          "$ref": "#/$defs/sourceMetadata"
        }
      },
      "required": [
        "fits"
      ],
      "additionalProperties": false
    }
  }
}
