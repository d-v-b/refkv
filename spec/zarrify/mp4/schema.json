{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/d-v-b/refkv/refs/heads/main/spec/zarrify/mp4/schema.json",
  "title": "refkv MP4 convention, version 0",
  "description": "The zarr.json of a node that declares the refkv MP4 convention (https://github.com/d-v-b/refkv/blob/main/spec/zarrify/mp4.md)",
  "type": "object",
  "properties": {
    "zarr_format": {
      "type": "integer",
      "const": 3
    },
    "node_type": {
      "type": "string",
      "enum": [
        "group",
        "array"
      ]
    },
    "attributes": {
      "type": "object",
      "properties": {
        "ome": {
          "type": "object",
          "description": "OME-NGFF 0.5 metadata"
        },
        "zarr_conventions": {
          "type": "array",
          "contains": {
            "$ref": "#/$defs/conventionMetadata"
          },
          "minContains": 1,
          "maxContains": 1
        },
        "refkv_zarrified": {
          "oneOf": [
            {
              "$ref": "#/$defs/rootProperty"
            },
            {
              "$ref": "#/$defs/nodeProperty"
            }
          ]
        }
      },
      "required": [
        "zarr_conventions",
        "refkv_zarrified"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "zarr_format",
    "node_type",
    "attributes"
  ],
  "$defs": {
    "conventionMetadata": {
      "type": "object",
      "description": "The MP4 convention's metadata object in zarr_conventions",
      "properties": {
        "uuid": {
          "type": "string",
          "const": "bbe3f6b9-488d-4d8d-85ce-60a1649dd27e"
        },
        "schema_url": {
          "type": "string",
          "const": "https://raw.githubusercontent.com/d-v-b/refkv/refs/heads/main/spec/zarrify/mp4/schema.json"
        },
        "spec_url": {
          "type": "string",
          "const": "https://github.com/d-v-b/refkv/blob/main/spec/zarrify/mp4.md"
        },
        "name": {
          "type": "string",
          "const": "refkv_zarrified"
        },
        "description": {
          "type": "string",
          "const": "The Zarr layout of a MP4 source zarrified by refkv, and the source's metadata"
        }
      },
      "required": [
        "uuid",
        "schema_url",
        "spec_url",
        "name",
        "description"
      ],
      "additionalProperties": false
    },
    "rootProperty": {
      "type": "object",
      "description": "The root's property: the profile and version that produced the hierarchy, its source, and the root's source metadata",
      "properties": {
        "profile": {
          "type": "string",
          "const": "mp4"
        },
        "version": {
          "type": "integer",
          "const": 0
        },
        "source": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "description": "The URL of the source file"
            }
          },
          "required": [
            "url"
          ],
          "additionalProperties": false
        },
        "layouts": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[^/]+(/[^/]+)*$"
          },
          "description": "The other layouts of the source in this hierarchy, by name, each the path of its node below the root (spec/conventions.md §9 <https://github.com/d-v-b/refkv/blob/main/spec/conventions.md#9-dataset-layouts>)"
        },
        "mp4": {
          "$ref": "#/$defs/sourceMetadata"
        }
      },
      "required": [
        "profile",
        "version",
        "source"
      ],
      "additionalProperties": false
    },
    "sourceMetadata": {
      "anyOf": [
        {
          "type": "object",
          "description": "The root's: the file's brands, the movie's timescale and duration, and every track, with where it is or why it is not zarrified (spec/zarrify/mp4.md §5.1 <https://github.com/d-v-b/refkv/blob/main/spec/zarrify/mp4.md#51-the-root>)",
          "properties": {
            "brand": {
              "type": "object",
              "properties": {
                "major": {
                  "type": "string"
                },
                "minor": {
                  "type": "integer"
                },
                "compatible": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "major",
                "minor",
                "compatible"
              ],
              "additionalProperties": false
            },
            "timescale": {
              "type": "integer",
              "minimum": 0
            },
            "duration": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "string",
                  "pattern": "^[1-9][0-9]{15,19}$"
                }
              ]
            },
            "tracks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "integer"
                  },
                  "handler": {
                    "type": "string"
                  },
                  "codec": {
                    "type": "string"
                  },
                  "path": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "The track's group, when it is zarrified"
                  },
                  "reason": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Why it is not, when it is not"
                  }
                },
                "required": [
                  "id",
                  "handler",
                  "codec",
                  "path",
                  "reason"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "timescale",
            "duration",
            "tracks"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "A video track's group (spec/zarrify/mp4.md §5.2 <https://github.com/d-v-b/refkv/blob/main/spec/zarrify/mp4.md#52-the-tracks>)",
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 0,
              "description": "The track's ID (its tkhd box's)"
            },
            "handler": {
              "type": "string",
              "description": "The handler type of its mdia box's hdlr box: vide or soun"
            },
            "codec": {
              "type": "string",
              "description": "Its sample entry's type: avc1, mp4a or .mp3"
            },
            "timescale": {
              "type": "integer",
              "minimum": 1,
              "description": "The media timescale: time units a second"
            },
            "duration": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "string",
                  "pattern": "^[1-9][0-9]{15,19}$"
                }
              ],
              "description": "The media duration, in the timescale"
            },
            "edits": {
              "type": "array",
              "description": "The track's edit list (its elst box's entries), recorded and not applied",
              "items": {
                "type": "object",
                "properties": {
                  "duration": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0
                      },
                      {
                        "type": "string",
                        "pattern": "^[1-9][0-9]{15,19}$"
                      }
                    ]
                  },
                  "media_time": {
                    "anyOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "string",
                        "pattern": "^-?[1-9][0-9]{15,18}$"
                      }
                    ]
                  },
                  "rate": {
                    "type": "number"
                  }
                },
                "required": [
                  "duration",
                  "media_time",
                  "rate"
                ],
                "additionalProperties": false
              }
            },
            "frames": {
              "type": "integer",
              "minimum": 1,
              "description": "The track's samples: coded pictures, or coded audio frames"
            },
            "chunk_frames": {
              "type": "integer",
              "minimum": 1,
              "description": "The frames of a chunk of the track's arrays"
            },
            "format": {
              "const": "h264"
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            },
            "profile": {
              "type": "integer",
              "description": "The SPS's profile_idc"
            },
            "level": {
              "type": "integer",
              "description": "The SPS's level_idc"
            },
            "sync_samples": {
              "type": "integer",
              "minimum": 1,
              "description": "The keyframes"
            }
          },
          "required": [
            "id",
            "handler",
            "codec",
            "timescale",
            "duration",
            "edits",
            "frames",
            "chunk_frames",
            "format",
            "width",
            "height",
            "profile",
            "level",
            "sync_samples"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "An audio track's group (spec/zarrify/mp4.md §5.2 <https://github.com/d-v-b/refkv/blob/main/spec/zarrify/mp4.md#52-the-tracks>)",
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 0,
              "description": "The track's ID (its tkhd box's)"
            },
            "handler": {
              "type": "string",
              "description": "The handler type of its mdia box's hdlr box: vide or soun"
            },
            "codec": {
              "type": "string",
              "description": "Its sample entry's type: avc1, mp4a or .mp3"
            },
            "timescale": {
              "type": "integer",
              "minimum": 1,
              "description": "The media timescale: time units a second"
            },
            "duration": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "string",
                  "pattern": "^[1-9][0-9]{15,19}$"
                }
              ],
              "description": "The media duration, in the timescale"
            },
            "edits": {
              "type": "array",
              "description": "The track's edit list (its elst box's entries), recorded and not applied",
              "items": {
                "type": "object",
                "properties": {
                  "duration": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0
                      },
                      {
                        "type": "string",
                        "pattern": "^[1-9][0-9]{15,19}$"
                      }
                    ]
                  },
                  "media_time": {
                    "anyOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "string",
                        "pattern": "^-?[1-9][0-9]{15,18}$"
                      }
                    ]
                  },
                  "rate": {
                    "type": "number"
                  }
                },
                "required": [
                  "duration",
                  "media_time",
                  "rate"
                ],
                "additionalProperties": false
              }
            },
            "frames": {
              "type": "integer",
              "minimum": 1,
              "description": "The track's samples: coded pictures, or coded audio frames"
            },
            "chunk_frames": {
              "type": "integer",
              "minimum": 1,
              "description": "The frames of a chunk of the track's arrays"
            },
            "format": {
              "enum": [
                "aac",
                "mp3"
              ]
            },
            "sample_rate": {
              "type": "integer",
              "minimum": 1
            },
            "channels": {
              "type": "integer",
              "minimum": 1
            },
            "samples_per_frame": {
              "enum": [
                576,
                1024,
                1152
              ]
            },
            "samples": {
              "type": "integer",
              "minimum": 1,
              "description": "frames * samples_per_frame"
            }
          },
          "required": [
            "id",
            "handler",
            "codec",
            "timescale",
            "duration",
            "edits",
            "frames",
            "chunk_frames",
            "format",
            "sample_rate",
            "channels",
            "samples_per_frame",
            "samples"
          ],
          "additionalProperties": false
        },
        {
          "$ref": "#/$defs/mirror"
        },
        {
          "$ref": "#/$defs/mirrorView"
        }
      ]
    },
    "headerValue": {
      "description": "A translated header value (spec/conventions.md §6 <https://github.com/d-v-b/refkv/blob/main/spec/conventions.md#6-source-metadata-as-json>)",
      "anyOf": [
        {
          "type": "number"
        },
        {
          "$ref": "#/$defs/text"
        },
        {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ]
          }
        }
      ]
    },
    "text": {
      "description": "A text value: a string (UTF-8), or its ISO 8859-1 reading when it is not UTF-8",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "latin1": {
              "type": "string"
            }
          },
          "required": [
            "latin1"
          ],
          "additionalProperties": false
        }
      ]
    },
    "mirror": {
      "type": "object",
      "description": "refkv_source's: the IR mirror's description (spec/conventions.md §8.2 <https://github.com/d-v-b/refkv/blob/main/spec/conventions.md#82-the-table>)",
      "properties": {
        "ir": {
          "type": "object",
          "properties": {
            "version": {
              "const": 2
            },
            "size": {
              "type": "integer",
              "minimum": 0,
              "description": "The source's size in bytes (a store IR's: its objects' sizes, summed)"
            },
            "objects": {
              "type": "integer",
              "minimum": 0,
              "description": "A store IR's objects (spec/conventions.md §8.9 <https://github.com/d-v-b/refkv/blob/main/spec/conventions.md#89-stores>); a file IR has none"
            },
            "elements": {
              "type": "integer",
              "minimum": 1,
              "description": "The elements, column runs expanded"
            },
            "rows": {
              "type": "integer",
              "minimum": 1,
              "description": "The rows the table stores"
            },
            "names": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "prefixItems": [
                {
                  "const": ""
                }
              ],
              "description": "The interned names, sorted; the first, \"\", is the root's (conventions §8.1 <https://github.com/d-v-b/refkv/blob/main/spec/conventions.md#81-elements>)"
            },
            "types": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "prefixItems": [
                {
                  "const": ""
                }
              ],
              "description": "The interned types (§8.6 <https://github.com/d-v-b/refkv/blob/main/spec/conventions.md#86-types>)"
            },
            "forms": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "The interned forms, each a JSON text (§8.5 <https://github.com/d-v-b/refkv/blob/main/spec/conventions.md#85-forms-and-recipes>)"
            }
          },
          "required": [
            "version",
            "size",
            "elements",
            "rows",
            "names",
            "types",
            "forms"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "ir"
      ],
      "additionalProperties": false
    },
    "mirrorView": {
      "type": "object",
      "description": "A view group's (refkv_source/tree/...): a struct's view document (spec/conventions.md §8.7 <https://github.com/d-v-b/refkv/blob/main/spec/conventions.md#87-the-view>)",
      "properties": {
        "$vz": {
          "const": "derived",
          "description": "A derived element's document"
        },
        "$form": {
          "type": [
            "string",
            "null"
          ],
          "description": "A derived element's form (§8.5 <https://github.com/d-v-b/refkv/blob/main/spec/conventions.md#85-forms-and-recipes>)"
        },
        "$partial": {
          "const": true,
          "description": "The document stops short of the struct's children"
        }
      },
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/viewValue"
      }
    },
    "viewValue": {
      "description": "A child's view: a JSON value, a nested document, or a $vz form",
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null",
            "array"
          ]
        },
        {
          "type": "object",
          "properties": {
            "$vz": {
              "enum": [
                "alias",
                "group",
                "element",
                "derived",
                "int",
                "float",
                "bytes",
                "utf16"
              ]
            }
          },
          "required": [
            "$vz"
          ]
        },
        {
          "type": "object"
        }
      ]
    },
    "nodeProperty": {
      "type": "object",
      "description": "Any other node's property: its source metadata only",
      "properties": {
        "mp4": {
          "$ref": "#/$defs/sourceMetadata"
        }
      },
      "required": [
        "mp4"
      ],
      "additionalProperties": false
    }
  }
}
