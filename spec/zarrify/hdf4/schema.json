{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/d-v-b/refkv/refs/heads/main/spec/zarrify/hdf4/schema.json",
  "title": "refkv HDF4 convention, version 0",
  "description": "The zarr.json of a node that declares the refkv HDF4 convention (https://github.com/d-v-b/refkv/blob/main/spec/zarrify/hdf4.md)",
  "type": "object",
  "properties": {
    "zarr_format": {
      "type": "integer",
      "const": 3
    },
    "node_type": {
      "type": "string",
      "enum": [
        "group",
        "array"
      ]
    },
    "attributes": {
      "type": "object",
      "properties": {
        "ome": {
          "type": "object",
          "description": "OME-NGFF 0.5 metadata"
        },
        "zarr_conventions": {
          "type": "array",
          "contains": {
            "$ref": "#/$defs/conventionMetadata"
          },
          "minContains": 1,
          "maxContains": 1
        },
        "refkv_zarrified": {
          "oneOf": [
            {
              "$ref": "#/$defs/rootProperty"
            },
            {
              "$ref": "#/$defs/nodeProperty"
            }
          ]
        }
      },
      "required": [
        "zarr_conventions",
        "refkv_zarrified"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "zarr_format",
    "node_type",
    "attributes"
  ],
  "$defs": {
    "conventionMetadata": {
      "type": "object",
      "description": "The HDF4 convention's metadata object in zarr_conventions",
      "properties": {
        "uuid": {
          "type": "string",
          "const": "af66c29e-fc1a-44a4-bb71-1055ad5fdb0a"
        },
        "schema_url": {
          "type": "string",
          "const": "https://raw.githubusercontent.com/d-v-b/refkv/refs/heads/main/spec/zarrify/hdf4/schema.json"
        },
        "spec_url": {
          "type": "string",
          "const": "https://github.com/d-v-b/refkv/blob/main/spec/zarrify/hdf4.md"
        },
        "name": {
          "type": "string",
          "const": "refkv_zarrified"
        },
        "description": {
          "type": "string",
          "const": "The Zarr layout of a HDF4 source zarrified by refkv, and the source's metadata"
        }
      },
      "required": [
        "uuid",
        "schema_url",
        "spec_url",
        "name",
        "description"
      ],
      "additionalProperties": false
    },
    "rootProperty": {
      "type": "object",
      "description": "The root's property: the profile and version that produced the hierarchy, its source, and the root's source metadata",
      "properties": {
        "profile": {
          "type": "string",
          "const": "hdf4"
        },
        "version": {
          "type": "integer",
          "const": 0
        },
        "source": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "description": "The URL of the source file"
            }
          },
          "required": [
            "url"
          ],
          "additionalProperties": false
        },
        "layouts": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[^/]+(/[^/]+)*$"
          },
          "description": "The other layouts of the source in this hierarchy, by name, each the path of its node below the root (spec/conventions.md §9 <https://github.com/d-v-b/refkv/blob/main/spec/conventions.md#9-dataset-layouts>)"
        },
        "hdf4": {
          "$ref": "#/$defs/sourceMetadata"
        }
      },
      "required": [
        "profile",
        "version",
        "source"
      ],
      "additionalProperties": false
    },
    "sourceMetadata": {
      "anyOf": [
        {
          "type": "object",
          "description": "A group's: the root's or a Vgroup's (https://github.com/d-v-b/refkv/blob/main/spec/zarrify/hdf4.md#71-groups)",
          "properties": {
            "ref": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "class": {
              "$ref": "#/$defs/text"
            },
            "version": {
              "type": "object",
              "properties": {
                "major": {
                  "type": "integer"
                },
                "minor": {
                  "type": "integer"
                },
                "release": {
                  "type": "integer"
                },
                "text": {
                  "$ref": "#/$defs/text"
                }
              },
              "required": [
                "major",
                "minor",
                "release",
                "text"
              ],
              "additionalProperties": false,
              "description": "The root's: the version of the library that wrote the file"
            },
            "cdf": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                },
                {
                  "type": "null"
                }
              ],
              "description": "The root's: the CDF0.0 Vgroup's ref"
            },
            "attributes": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/hdf4AttributeType"
              },
              "description": "Each attribute's type, by name"
            },
            "unpresented_attributes": {
              "type": "object",
              "additionalProperties": {
                "enum": [
                  "reserved",
                  "budget",
                  "datatype",
                  "attribute"
                ]
              },
              "description": "The attributes not presented, by name, each with the reason"
            },
            "links": {
              "type": "array",
              "description": "The members the walk reached again, each at its canonical path",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "$ref": "#/$defs/text"
                  },
                  "tag": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                  },
                  "ref": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                  },
                  "path": {
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "tag",
                  "ref",
                  "path"
                ],
                "additionalProperties": false
              }
            },
            "unpresented": {
              "type": "array",
              "description": "The members not presented, in the walk's order (https://github.com/d-v-b/refkv/blob/main/spec/zarrify/hdf4.md#74-what-is-not-presented)",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "$ref": "#/$defs/text"
                  },
                  "tag": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                  },
                  "ref": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                  },
                  "reason": {
                    "enum": [
                      "name",
                      "reserved",
                      "duplicate",
                      "depth",
                      "char8",
                      "number_type",
                      "dimensions",
                      "size",
                      "compression",
                      "chunks",
                      "length",
                      "external",
                      "special",
                      "dfsd",
                      "table",
                      "object"
                    ]
                  }
                },
                "required": [
                  "tag",
                  "ref",
                  "reason"
                ],
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "A dataset's (https://github.com/d-v-b/refkv/blob/main/spec/zarrify/hdf4.md#72-datasets)",
          "properties": {
            "ref": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "ndg": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "number_type": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                },
                "width": {
                  "type": "integer"
                },
                "class": {
                  "type": "integer"
                }
              },
              "required": [
                "type",
                "width",
                "class"
              ],
              "additionalProperties": false
            },
            "layout": {
              "enum": [
                "none",
                "contiguous",
                "linked",
                "compressed",
                "chunked"
              ]
            },
            "compression": {
              "type": "string",
              "description": "The method's name: none, rle, nbit, skipping_huffman, deflate, szip, jpeg, imcomp, or `code <n>` for another"
            },
            "chunks": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "chunk_fill_value": {
              "type": "string",
              "description": "The chunked header's fill value, in base64"
            },
            "unlimited": {
              "const": true
            },
            "sdd": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "description": "The SDD's sizes, of a dataset with an unlimited dimension"
            },
            "coordinate": {
              "type": "boolean"
            },
            "attributes": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/hdf4AttributeType"
              },
              "description": "Each attribute's type, by name"
            },
            "unpresented_attributes": {
              "type": "object",
              "additionalProperties": {
                "enum": [
                  "reserved",
                  "budget",
                  "datatype",
                  "attribute"
                ]
              },
              "description": "The attributes not presented, by name, each with the reason"
            }
          },
          "required": [
            "ref",
            "number_type",
            "layout"
          ],
          "additionalProperties": false
        },
        {
          "$ref": "#/$defs/mirror"
        },
        {
          "$ref": "#/$defs/mirrorView"
        }
      ]
    },
    "headerValue": {
      "description": "A translated header value (spec/conventions.md §6 <https://github.com/d-v-b/refkv/blob/main/spec/conventions.md#6-source-metadata-as-json>)",
      "anyOf": [
        {
          "type": "number"
        },
        {
          "$ref": "#/$defs/text"
        },
        {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ]
          }
        }
      ]
    },
    "text": {
      "description": "A text value: a string (UTF-8), or its ISO 8859-1 reading when it is not UTF-8",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "latin1": {
              "type": "string"
            }
          },
          "required": [
            "latin1"
          ],
          "additionalProperties": false
        }
      ]
    },
    "mirror": {
      "type": "object",
      "description": "refkv_source's: the IR mirror's description (spec/conventions.md §8.2 <https://github.com/d-v-b/refkv/blob/main/spec/conventions.md#82-the-table>)",
      "properties": {
        "ir": {
          "type": "object",
          "properties": {
            "version": {
              "const": 2
            },
            "size": {
              "type": "integer",
              "minimum": 0,
              "description": "The source's size in bytes (a store IR's: its objects' sizes, summed)"
            },
            "objects": {
              "type": "integer",
              "minimum": 0,
              "description": "A store IR's objects (spec/conventions.md §8.9 <https://github.com/d-v-b/refkv/blob/main/spec/conventions.md#89-stores>); a file IR has none"
            },
            "elements": {
              "type": "integer",
              "minimum": 1,
              "description": "The elements, column runs expanded"
            },
            "rows": {
              "type": "integer",
              "minimum": 1,
              "description": "The rows the table stores"
            },
            "names": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "prefixItems": [
                {
                  "const": ""
                }
              ],
              "description": "The interned names, sorted; the first, \"\", is the root's (conventions §8.1 <https://github.com/d-v-b/refkv/blob/main/spec/conventions.md#81-elements>)"
            },
            "types": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "prefixItems": [
                {
                  "const": ""
                }
              ],
              "description": "The interned types (§8.6 <https://github.com/d-v-b/refkv/blob/main/spec/conventions.md#86-types>)"
            },
            "forms": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "The interned forms, each a JSON text (§8.5 <https://github.com/d-v-b/refkv/blob/main/spec/conventions.md#85-forms-and-recipes>)"
            }
          },
          "required": [
            "version",
            "size",
            "elements",
            "rows",
            "names",
            "types",
            "forms"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "ir"
      ],
      "additionalProperties": false
    },
    "mirrorView": {
      "type": "object",
      "description": "A view group's (refkv_source/tree/...): a struct's view document (spec/conventions.md §8.7 <https://github.com/d-v-b/refkv/blob/main/spec/conventions.md#87-the-view>)",
      "properties": {
        "$vz": {
          "const": "derived",
          "description": "A derived element's document"
        },
        "$form": {
          "type": [
            "string",
            "null"
          ],
          "description": "A derived element's form (§8.5 <https://github.com/d-v-b/refkv/blob/main/spec/conventions.md#85-forms-and-recipes>)"
        },
        "$partial": {
          "const": true,
          "description": "The document stops short of the struct's children"
        }
      },
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/viewValue"
      }
    },
    "viewValue": {
      "description": "A child's view: a JSON value, a nested document, or a $vz form",
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null",
            "array"
          ]
        },
        {
          "type": "object",
          "properties": {
            "$vz": {
              "enum": [
                "alias",
                "group",
                "element",
                "derived",
                "float",
                "bytes",
                "utf16"
              ]
            }
          },
          "required": [
            "$vz"
          ]
        },
        {
          "type": "object"
        }
      ]
    },
    "hdf4AttributeType": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "endian": {
          "const": "little"
        }
      },
      "required": [
        "type",
        "count"
      ],
      "additionalProperties": false,
      "description": "An attribute's field type and value count (https://github.com/d-v-b/refkv/blob/main/spec/zarrify/hdf4.md#71-groups)"
    },
    "nodeProperty": {
      "type": "object",
      "description": "Any other node's property: its source metadata only",
      "properties": {
        "hdf4": {
          "$ref": "#/$defs/sourceMetadata"
        }
      },
      "required": [
        "hdf4"
      ],
      "additionalProperties": false
    }
  }
}
