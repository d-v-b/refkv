{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/d-v-b/refkv/refs/heads/main/spec/virtualize/mp3/schema.json",
  "title": "refkv MP3 convention, version 0",
  "description": "The zarr.json of a node that declares the refkv MP3 convention (https://github.com/d-v-b/refkv/blob/main/spec/virtualize/mp3.md)",
  "type": "object",
  "properties": {
    "zarr_format": {
      "type": "integer",
      "const": 3
    },
    "node_type": {
      "type": "string",
      "enum": [
        "group",
        "array"
      ]
    },
    "attributes": {
      "type": "object",
      "properties": {
        "ome": {
          "type": "object",
          "description": "OME-NGFF 0.5 metadata"
        },
        "zarr_conventions": {
          "type": "array",
          "contains": {
            "$ref": "#/$defs/conventionMetadata"
          },
          "minContains": 1,
          "maxContains": 1
        },
        "refkv_virtualized": {
          "oneOf": [
            {
              "$ref": "#/$defs/rootProperty"
            },
            {
              "$ref": "#/$defs/nodeProperty"
            }
          ]
        }
      },
      "required": [
        "zarr_conventions",
        "refkv_virtualized"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "zarr_format",
    "node_type",
    "attributes"
  ],
  "$defs": {
    "conventionMetadata": {
      "type": "object",
      "description": "The MP3 convention's metadata object in zarr_conventions",
      "properties": {
        "uuid": {
          "type": "string",
          "const": "b6cb0047-9448-4fdc-b03e-10dd3d6aa829"
        },
        "schema_url": {
          "type": "string",
          "const": "https://raw.githubusercontent.com/d-v-b/refkv/refs/heads/main/spec/virtualize/mp3/schema.json"
        },
        "spec_url": {
          "type": "string",
          "const": "https://github.com/d-v-b/refkv/blob/main/spec/virtualize/mp3.md"
        },
        "name": {
          "type": "string",
          "const": "refkv_virtualized"
        },
        "description": {
          "type": "string",
          "const": "The Zarr layout of a MP3 source virtualized by refkv, and the source's metadata"
        }
      },
      "required": [
        "uuid"
      ],
      "additionalProperties": false
    },
    "rootProperty": {
      "type": "object",
      "description": "The root's property: the profile and version that produced the hierarchy, its source, and the root's source metadata",
      "properties": {
        "profile": {
          "type": "string",
          "const": "mp3"
        },
        "version": {
          "type": "integer",
          "const": 0
        },
        "source": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "description": "The URL of the source file"
            }
          },
          "required": [
            "url"
          ],
          "additionalProperties": false
        },
        "layouts": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[^/]+(/[^/]+)*$"
          },
          "description": "The other layouts of the source in this hierarchy, by name, each the path of its node below the root (spec/conventions.md §9 <https://github.com/d-v-b/refkv/blob/main/spec/conventions.md#9-dataset-layouts>)"
        },
        "mp3": {
          "$ref": "#/$defs/sourceMetadata"
        }
      },
      "required": [
        "profile",
        "version",
        "source"
      ],
      "additionalProperties": false
    },
    "sourceMetadata": {
      "anyOf": [
        {
          "type": "object",
          "description": "The root's: the stream's parameters, derived from its frames, and the fields of its info frame and tags (spec/virtualize/mp3.md §5.1 <https://github.com/d-v-b/refkv/blob/main/spec/virtualize/mp3.md#51-the-root>)",
          "properties": {
            "version": {
              "enum": [
                "MPEG-1",
                "MPEG-2",
                "MPEG-2.5"
              ]
            },
            "layer": {
              "const": 3
            },
            "sample_rate": {
              "enum": [
                8000,
                11025,
                12000,
                16000,
                22050,
                24000,
                32000,
                44100,
                48000
              ]
            },
            "channels": {
              "enum": [
                1,
                2
              ]
            },
            "channel_mode": {
              "enum": [
                "stereo",
                "joint_stereo",
                "dual_channel",
                "mono"
              ],
              "description": "The first audio frame's channel mode"
            },
            "samples_per_frame": {
              "enum": [
                576,
                1152
              ]
            },
            "frames": {
              "type": "integer",
              "minimum": 1,
              "description": "The audio frames (the info frame is not one)"
            },
            "samples": {
              "type": "integer",
              "minimum": 1,
              "description": "frames * samples_per_frame"
            },
            "duration": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "samples / sample_rate, in seconds"
            },
            "bitrate_mode": {
              "enum": [
                "constant",
                "variable"
              ]
            },
            "bitrate_kbps": {
              "type": [
                "integer",
                "null"
              ],
              "description": "The bitrate of every audio frame, or null when they differ"
            },
            "crc_frames": {
              "type": "integer",
              "minimum": 0,
              "description": "The audio frames with a CRC"
            },
            "info": {
              "type": "object",
              "description": "The info frame's fields: a Xing, Info or VBRI tag, and a LAME tag after a Xing or Info one",
              "properties": {
                "tag": {
                  "enum": [
                    "Xing",
                    "Info",
                    "VBRI"
                  ]
                },
                "frames": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "bytes": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "quality": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "encoder": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "The LAME tag's 9-byte encoder version, when printable"
                },
                "delay": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "description": "The encoder delay in samples (a LAME tag's, or a VBRI tag's)"
                },
                "padding": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "description": "The encoder padding in samples (a LAME tag's)"
                }
              },
              "required": [
                "tag",
                "frames",
                "bytes",
                "quality",
                "encoder",
                "delay",
                "padding"
              ],
              "additionalProperties": false
            },
            "id3v2": {
              "type": "array",
              "minItems": 1,
              "description": "The ID3v2 tags at the start, in order: each header's version, flags and size, and whether it has a footer",
              "items": {
                "type": "object",
                "properties": {
                  "version": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 255
                    },
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "flags": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "footer": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "version",
                  "flags",
                  "size",
                  "footer"
                ],
                "additionalProperties": false
              }
            },
            "id3v1": {
              "type": "object",
              "description": "The ID3v1 tag's fields: each text up to its first NUL",
              "properties": {
                "title": {
                  "$ref": "#/$defs/text"
                },
                "artist": {
                  "$ref": "#/$defs/text"
                },
                "album": {
                  "$ref": "#/$defs/text"
                },
                "year": {
                  "$ref": "#/$defs/text"
                },
                "comment": {
                  "$ref": "#/$defs/text"
                },
                "track": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "description": "An ID3v1.1 tag's track number"
                },
                "genre": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                }
              },
              "required": [
                "title",
                "artist",
                "album",
                "year",
                "comment",
                "track",
                "genre"
              ],
              "additionalProperties": false
            },
            "ape": {
              "type": "object",
              "description": "The APE tag's footer fields, and the tag's whole size",
              "properties": {
                "version": {
                  "type": "integer",
                  "minimum": 0
                },
                "size": {
                  "type": "integer",
                  "minimum": 32
                },
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "version",
                "size",
                "items"
              ],
              "additionalProperties": false
            },
            "stray_bytes": {
              "type": "integer",
              "minimum": 0,
              "description": "The bytes between the tags that are in no frame"
            }
          },
          "required": [
            "version",
            "layer",
            "sample_rate",
            "channels",
            "channel_mode",
            "samples_per_frame",
            "frames",
            "samples",
            "duration",
            "bitrate_mode",
            "bitrate_kbps",
            "crc_frames",
            "stray_bytes"
          ],
          "additionalProperties": false
        },
        {
          "$ref": "#/$defs/mirror"
        },
        {
          "$ref": "#/$defs/mirrorView"
        }
      ]
    },
    "headerValue": {
      "description": "A translated header value (spec/conventions.md §6 <https://github.com/d-v-b/refkv/blob/main/spec/conventions.md#6-source-metadata-as-json>)",
      "anyOf": [
        {
          "type": "number"
        },
        {
          "$ref": "#/$defs/text"
        },
        {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ]
          }
        }
      ]
    },
    "text": {
      "description": "A text value: a string (UTF-8), or its ISO 8859-1 reading when it is not UTF-8",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "latin1": {
              "type": "string"
            }
          },
          "required": [
            "latin1"
          ],
          "additionalProperties": false
        }
      ]
    },
    "mirror": {
      "type": "object",
      "description": "refkv_source's: the IR mirror's description (spec/conventions.md §8.2 <https://github.com/d-v-b/refkv/blob/main/spec/conventions.md#82-the-table>)",
      "properties": {
        "ir": {
          "type": "object",
          "properties": {
            "version": {
              "const": 2
            },
            "size": {
              "type": "integer",
              "minimum": 0,
              "description": "The source's size in bytes (a store IR's: its objects' sizes, summed)"
            },
            "objects": {
              "type": "integer",
              "minimum": 0,
              "description": "A store IR's objects (spec/conventions.md §8.9 <https://github.com/d-v-b/refkv/blob/main/spec/conventions.md#89-stores>); a file IR has none"
            },
            "elements": {
              "type": "integer",
              "minimum": 1,
              "description": "The elements, column runs expanded"
            },
            "rows": {
              "type": "integer",
              "minimum": 1,
              "description": "The rows the table stores"
            },
            "names": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "prefixItems": [
                {
                  "const": ""
                }
              ],
              "description": "The interned names, sorted; the first, \"\", is the root's (conventions §8.1 <https://github.com/d-v-b/refkv/blob/main/spec/conventions.md#81-elements>)"
            },
            "types": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "prefixItems": [
                {
                  "const": ""
                }
              ],
              "description": "The interned types (§8.6 <https://github.com/d-v-b/refkv/blob/main/spec/conventions.md#86-types>)"
            },
            "forms": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "The interned forms, each a JSON text (§8.5 <https://github.com/d-v-b/refkv/blob/main/spec/conventions.md#85-forms-and-recipes>)"
            }
          },
          "required": [
            "version",
            "size",
            "elements",
            "rows",
            "names",
            "types",
            "forms"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "ir"
      ],
      "additionalProperties": false
    },
    "mirrorView": {
      "type": "object",
      "description": "A view group's (refkv_source/tree/...): a struct's view document (spec/conventions.md §8.7 <https://github.com/d-v-b/refkv/blob/main/spec/conventions.md#87-the-view>)",
      "properties": {
        "$vz": {
          "const": "derived",
          "description": "A derived element's document"
        },
        "$form": {
          "type": [
            "string",
            "null"
          ],
          "description": "A derived element's form (§8.5 <https://github.com/d-v-b/refkv/blob/main/spec/conventions.md#85-forms-and-recipes>)"
        },
        "$partial": {
          "const": true,
          "description": "The document stops short of the struct's children"
        }
      },
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/viewValue"
      }
    },
    "viewValue": {
      "description": "A child's view: a JSON value, a nested document, or a $vz form",
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null",
            "array"
          ]
        },
        {
          "type": "object",
          "properties": {
            "$vz": {
              "enum": [
                "alias",
                "group",
                "element",
                "derived",
                "int",
                "float",
                "bytes",
                "utf16"
              ]
            }
          },
          "required": [
            "$vz"
          ]
        },
        {
          "type": "object"
        }
      ]
    },
    "nodeProperty": {
      "type": "object",
      "description": "Any other node's property: its source metadata only",
      "properties": {
        "mp3": {
          "$ref": "#/$defs/sourceMetadata"
        }
      },
      "required": [
        "mp3"
      ],
      "additionalProperties": false
    }
  }
}
