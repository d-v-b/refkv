{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/d-v-b/refkv/refs/heads/main/spec/virtualize/safe/schema.json",
  "title": "refkv Sentinel-2 SAFE convention, version 0",
  "description": "The zarr.json of a node that declares the refkv Sentinel-2 SAFE convention (https://github.com/d-v-b/refkv/blob/main/spec/virtualize/safe.md)",
  "type": "object",
  "properties": {
    "zarr_format": {
      "type": "integer",
      "const": 3
    },
    "node_type": {
      "type": "string",
      "enum": [
        "group",
        "array"
      ]
    },
    "attributes": {
      "type": "object",
      "properties": {
        "ome": {
          "type": "object",
          "description": "OME-NGFF 0.5 metadata"
        },
        "zarr_conventions": {
          "type": "array",
          "contains": {
            "$ref": "#/$defs/conventionMetadata"
          },
          "minContains": 1,
          "maxContains": 1
        },
        "refkv_virtualized": {
          "oneOf": [
            {
              "$ref": "#/$defs/rootProperty"
            },
            {
              "$ref": "#/$defs/nodeProperty"
            }
          ]
        },
        "proj:code": {
          "type": "string"
        },
        "proj:wkt2": {
          "type": "string"
        },
        "spatial:dimensions": {
          "type": "array"
        },
        "spatial:transform": {
          "type": "array"
        },
        "spatial:shape": {
          "type": "array"
        },
        "spatial:bbox": {
          "type": "array"
        },
        "spatial:registration": {
          "type": "string"
        },
        "multiscales": {
          "type": "object"
        }
      },
      "required": [
        "zarr_conventions",
        "refkv_virtualized"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "zarr_format",
    "node_type",
    "attributes"
  ],
  "$defs": {
    "conventionMetadata": {
      "type": "object",
      "description": "The Sentinel-2 SAFE convention's metadata object in zarr_conventions",
      "properties": {
        "uuid": {
          "type": "string",
          "const": "ef81346c-19e8-42ad-93b0-a279ccaf44c1"
        },
        "schema_url": {
          "type": "string",
          "const": "https://raw.githubusercontent.com/d-v-b/refkv/refs/heads/main/spec/virtualize/safe/schema.json"
        },
        "spec_url": {
          "type": "string",
          "const": "https://github.com/d-v-b/refkv/blob/main/spec/virtualize/safe.md"
        },
        "name": {
          "type": "string",
          "const": "refkv_virtualized"
        },
        "description": {
          "type": "string",
          "const": "The Zarr layout of a Sentinel-2 SAFE source virtualized by refkv, and the source's metadata"
        }
      },
      "required": [
        "uuid"
      ],
      "additionalProperties": false
    },
    "rootProperty": {
      "type": "object",
      "description": "The root's property: the profile and version that produced the hierarchy, its source, and the root's source metadata",
      "properties": {
        "profile": {
          "type": "string",
          "const": "safe"
        },
        "version": {
          "type": "integer",
          "const": 0
        },
        "revision": {
          "type": "integer",
          "const": 29,
          "description": "The spec/virtualize.md revision that produced the hierarchy (version 0 only)"
        },
        "source": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "description": "The URL of the source: a .SAFE directory's store URL, or a zip file's"
            }
          },
          "required": [
            "url"
          ],
          "additionalProperties": false
        },
        "layouts": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[^/]+(/[^/]+)*$"
          },
          "description": "The other layouts of the source in this hierarchy, by name, each the path of its node below the root (spec/conventions.md §9 <https://github.com/d-v-b/refkv/blob/main/spec/conventions.md#9-dataset-layouts>)"
        },
        "safe": {
          "$ref": "#/$defs/sourceMetadata"
        }
      },
      "required": [
        "profile",
        "version",
        "revision",
        "source"
      ],
      "additionalProperties": false
    },
    "sourceMetadata": {
      "oneOf": [
        {
          "type": "object",
          "description": "The root's: the product's identity, from the product and tile metadata (§6.3 <https://github.com/d-v-b/refkv/blob/main/spec/virtualize/safe.md#63-the-source-metadata-node>)",
          "properties": {
            "PRODUCT_URI": {
              "type": "string"
            },
            "PROCESSING_LEVEL": {
              "type": "string"
            },
            "PRODUCT_TYPE": {
              "type": "string"
            },
            "PROCESSING_BASELINE": {
              "type": "string"
            },
            "TILE_ID": {
              "type": "string"
            },
            "SENSING_TIME": {
              "type": "string"
            },
            "HORIZONTAL_CS_NAME": {
              "type": "string"
            },
            "HORIZONTAL_CS_CODE": {
              "type": "string"
            },
            "Special_Values": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "number",
                    "string"
                  ]
                }
              },
              "minItems": 1
            },
            "U": {
              "type": [
                "number",
                "string"
              ]
            }
          },
          "required": [
            "HORIZONTAL_CS_CODE"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "A band array's: a derived convenience copied from the product metadata (§6.2 <https://github.com/d-v-b/refkv/blob/main/spec/virtualize/safe.md#62-band-arrays>), and the band file's SIZ segment",
          "properties": {
            "IMAGE_FILE": {
              "type": "string"
            },
            "bandId": {
              "type": "integer",
              "minimum": 0
            },
            "physicalBand": {
              "type": "string"
            },
            "RESOLUTION": {
              "type": [
                "number",
                "string"
              ]
            },
            "Wavelength": {
              "type": "object",
              "properties": {
                "MIN": {
                  "anyOf": [
                    {
                      "type": [
                        "number",
                        "string"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "value": {
                          "type": [
                            "number",
                            "string"
                          ]
                        },
                        "unit": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "value",
                        "unit"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "MAX": {
                  "anyOf": [
                    {
                      "type": [
                        "number",
                        "string"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "value": {
                          "type": [
                            "number",
                            "string"
                          ]
                        },
                        "unit": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "value",
                        "unit"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "CENTRAL": {
                  "anyOf": [
                    {
                      "type": [
                        "number",
                        "string"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "value": {
                          "type": [
                            "number",
                            "string"
                          ]
                        },
                        "unit": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "value",
                        "unit"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "additionalProperties": false,
              "minProperties": 1
            },
            "PHYSICAL_GAINS": {
              "type": [
                "number",
                "string"
              ]
            },
            "RADIO_ADD_OFFSET": {
              "type": [
                "number",
                "string"
              ]
            },
            "BOA_ADD_OFFSET": {
              "type": [
                "number",
                "string"
              ]
            },
            "SOLAR_IRRADIANCE": {
              "anyOf": [
                {
                  "type": [
                    "number",
                    "string"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": [
                        "number",
                        "string"
                      ]
                    },
                    "unit": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "value",
                    "unit"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "QUANTIFICATION_VALUE": {
              "anyOf": [
                {
                  "type": [
                    "number",
                    "string"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": [
                        "number",
                        "string"
                      ]
                    },
                    "unit": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "value",
                    "unit"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "BOA_QUANTIFICATION_VALUE": {
              "anyOf": [
                {
                  "type": [
                    "number",
                    "string"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": [
                        "number",
                        "string"
                      ]
                    },
                    "unit": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "value",
                    "unit"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "AOT_QUANTIFICATION_VALUE": {
              "anyOf": [
                {
                  "type": [
                    "number",
                    "string"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": [
                        "number",
                        "string"
                      ]
                    },
                    "unit": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "value",
                    "unit"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "WVP_QUANTIFICATION_VALUE": {
              "anyOf": [
                {
                  "type": [
                    "number",
                    "string"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": [
                        "number",
                        "string"
                      ]
                    },
                    "unit": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "value",
                    "unit"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "Scene_Classification_List": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "number",
                    "string"
                  ]
                }
              },
              "minItems": 1
            },
            "siz": {
              "type": "string",
              "contentEncoding": "base64",
              "description": "The band file's SIZ marker segment, which its chunks replace"
            }
          },
          "required": [
            "IMAGE_FILE",
            "siz"
          ],
          "additionalProperties": false
        },
        {
          "$ref": "#/$defs/storeMirror"
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/mirrorView"
            },
            {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "ir"
                    ]
                  },
                  {
                    "required": [
                      "IMAGE_FILE"
                    ]
                  },
                  {
                    "required": [
                      "HORIZONTAL_CS_CODE"
                    ]
                  },
                  {
                    "required": [
                      "empty_dirs"
                    ]
                  },
                  {
                    "required": [
                      "ignored"
                    ]
                  },
                  {
                    "required": [
                      "xml_arrays"
                    ]
                  },
                  {
                    "required": [
                      "empty"
                    ]
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    "headerValue": {
      "description": "A translated header value (spec/conventions.md §6 <https://github.com/d-v-b/refkv/blob/main/spec/conventions.md#6-source-metadata-as-json>)",
      "anyOf": [
        {
          "type": "number"
        },
        {
          "$ref": "#/$defs/text"
        },
        {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ]
          }
        }
      ]
    },
    "text": {
      "description": "A text value: a string (UTF-8), or its ISO 8859-1 reading when it is not UTF-8",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "latin1": {
              "type": "string"
            }
          },
          "required": [
            "latin1"
          ],
          "additionalProperties": false
        }
      ]
    },
    "mirror": {
      "type": "object",
      "description": "refkv_source's: the IR mirror's description (spec/conventions.md §8.2 <https://github.com/d-v-b/refkv/blob/main/spec/conventions.md#82-the-table>)",
      "properties": {
        "ir": {
          "type": "object",
          "properties": {
            "version": {
              "const": 2
            },
            "size": {
              "type": "integer",
              "minimum": 0,
              "description": "The source's size in bytes (a store IR's: its objects' sizes, summed)"
            },
            "objects": {
              "type": "integer",
              "minimum": 0,
              "description": "A store IR's objects (spec/conventions.md §8.9 <https://github.com/d-v-b/refkv/blob/main/spec/conventions.md#89-stores>); a file IR has none"
            },
            "elements": {
              "type": "integer",
              "minimum": 1,
              "description": "The elements, column runs expanded"
            },
            "rows": {
              "type": "integer",
              "minimum": 1,
              "description": "The rows the table stores"
            },
            "names": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "prefixItems": [
                {
                  "const": ""
                }
              ],
              "description": "The interned names, sorted; the first, \"\", is the root's (conventions §8.1 <https://github.com/d-v-b/refkv/blob/main/spec/conventions.md#81-elements>)"
            },
            "types": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "prefixItems": [
                {
                  "const": ""
                }
              ],
              "description": "The interned types (§8.6 <https://github.com/d-v-b/refkv/blob/main/spec/conventions.md#86-types>)"
            },
            "forms": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "The interned forms, each a JSON text (§8.5 <https://github.com/d-v-b/refkv/blob/main/spec/conventions.md#85-forms-and-recipes>)"
            }
          },
          "required": [
            "version",
            "size",
            "elements",
            "rows",
            "names",
            "types",
            "forms"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "ir"
      ],
      "additionalProperties": false
    },
    "mirrorView": {
      "type": "object",
      "description": "A view group's (refkv_source/tree/...): a struct's view document (spec/conventions.md §8.7 <https://github.com/d-v-b/refkv/blob/main/spec/conventions.md#87-the-view>)",
      "properties": {
        "$vz": {
          "const": "derived",
          "description": "A derived element's document"
        },
        "$form": {
          "type": [
            "string",
            "null"
          ],
          "description": "A derived element's form (§8.5 <https://github.com/d-v-b/refkv/blob/main/spec/conventions.md#85-forms-and-recipes>)"
        },
        "$partial": {
          "const": true,
          "description": "The document stops short of the struct's children"
        }
      },
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/viewValue"
      }
    },
    "viewValue": {
      "description": "A child's view: a JSON value, a nested document, or a $vz form",
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null",
            "array"
          ]
        },
        {
          "type": "object",
          "properties": {
            "$vz": {
              "enum": [
                "alias",
                "group",
                "element",
                "derived",
                "int",
                "float",
                "bytes",
                "utf16"
              ]
            }
          },
          "required": [
            "$vz"
          ]
        },
        {
          "type": "object"
        }
      ]
    },
    "storeMirror": {
      "type": "object",
      "description": "refkv_source's, for a store convention: the IR mirror's description (spec/conventions.md §8.2 <https://github.com/d-v-b/refkv/blob/main/spec/conventions.md#82-the-table>, §8.9 <https://github.com/d-v-b/refkv/blob/main/spec/conventions.md#89-stores>), and the members the convention keeps beside it",
      "properties": {
        "ir": {
          "$ref": "#/$defs/mirror/properties/ir"
        },
        "empty_dirs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "A SAFE product's empty directories (spec/virtualize/safe.md §6.3 <https://github.com/d-v-b/refkv/blob/main/spec/virtualize/safe.md#63-the-source-metadata-node>)"
        },
        "ignored": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "The recorded keys of the listed objects that spec/virtualize.md §1.4 <https://github.com/d-v-b/refkv/blob/main/spec/virtualize.md#14-store-inputs> ignores"
        }
      },
      "required": [
        "ir"
      ],
      "additionalProperties": false
    },
    "nodeProperty": {
      "type": "object",
      "description": "Any other node's property: its source metadata only",
      "properties": {
        "safe": {
          "$ref": "#/$defs/sourceMetadata"
        }
      },
      "required": [
        "safe"
      ],
      "additionalProperties": false
    }
  }
}
