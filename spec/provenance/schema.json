{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/d-v-b/refkv/refs/heads/main/spec/provenance/schema.json",
  "title": "refkv provenance convention, version 0",
  "description": "The zarr.json of a root that declares the refkv provenance convention (https://github.com/d-v-b/refkv/blob/main/spec/provenance.md)",
  "type": "object",
  "properties": {
    "zarr_format": {"type": "integer", "const": 3},
    "node_type": {"type": "string", "const": "group"},
    "attributes": {
      "type": "object",
      "properties": {
        "zarr_conventions": {
          "type": "array",
          "contains": {"$ref": "#/$defs/conventionMetadata"},
          "minContains": 1,
          "maxContains": 1
        },
        "refkv_provenance": {"$ref": "#/$defs/provenance"}
      },
      "required": ["zarr_conventions", "refkv_provenance"],
      "additionalProperties": true
    }
  },
  "required": ["zarr_format", "node_type", "attributes"],
  "$defs": {
    "conventionMetadata": {
      "description": "The provenance convention's metadata object in zarr_conventions",
      "type": "object",
      "properties": {
        "uuid": {"const": "7ffd0ef7-df19-408c-a4df-c91623b4c3db"},
        "schema_url": {"const": "https://raw.githubusercontent.com/d-v-b/refkv/refs/heads/main/spec/provenance/schema.json"},
        "spec_url": {"const": "https://github.com/d-v-b/refkv/blob/main/spec/provenance.md"},
        "name": {"const": "refkv_provenance"},
        "description": {"const": "The program that wrote a Zarr hierarchy, and its version"}
      },
      "required": ["uuid", "schema_url", "spec_url", "name", "description"],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "producer": {"$ref": "#/$defs/producer"},
        "operation": {"type": "string", "minLength": 1},
        "created": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "plugins": {"type": "array", "items": {"$ref": "#/$defs/plugin"}}
      },
      "required": ["producer"],
      "additionalProperties": false
    },
    "producer": {
      "type": "object",
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "implementation": {"type": "string", "minLength": 1}
      },
      "required": ["name", "version"],
      "additionalProperties": false
    },
    "plugin": {
      "type": "object",
      "properties": {
        "layout": {"type": "string", "minLength": 1},
        "distribution": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      },
      "required": ["layout", "distribution", "version"],
      "additionalProperties": false
    }
  }
}
